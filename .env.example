# =============================================================================
# .env.example -- copia este archivo a ".env" y completa los valores.
# El proyecto lo carga automáticamente vía `load_dotenv()` en app.py.
# =============================================================================

# -----------------------------------------------------------------------
# Backend de LLM (ver get_llm() en app.py)
# -----------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=''
OPENAI_MODEL=gpt-5-mini


# -----------------------------------------------------------------------
# Servidores MCP (ver graph/workflow.py: _build_servers_config)
# Rutas relativas a la raíz del proyecto, a los scripts en mcp_servers/.
# -----------------------------------------------------------------------
MCP_CALCULO_SCRIPT=mcp_servers/calculo_server.py
MCP_GRAFICADO_SCRIPT=mcp_servers/graficado_server.py
MCP_RETRIEVAL_SCRIPT=mcp_servers/retrieval_server.py

# -----------------------------------------------------------------------
# Índice híbrido RAG (BM25 + ChromaDB) -- ver rag/loader.py, rag/vector_store.py
# Constrúyelo antes de correr la app:
#   python -m rag.loader ./mis_manuales --bm25-output manual_bm25.pkl --persist-dir ./chroma_manuales --collection manuales
# -----------------------------------------------------------------------
BM25_INDEX_PATH=manual_bm25.pkl
CHROMA_PERSIST_DIR=chroma_manuales
CHROMA_COLLECTION=manuales

# Backend de embeddings -- DEBE coincidir entre indexado (rag.loader) y
# consulta (rag.retriever / mcp_servers/retrieval_server.py).
EMBEDDING_BACKEND=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# Parámetros de Reciprocal Rank Fusion (ver rag/retriever.py) -- opcionales,
# 60/4/20 son los defaults razonables, normalmente no hace falta tocarlos.
RRF_K=100
RRF_CANDIDATE_MULTIPLIER=6
RRF_MIN_CANDIDATES=50

# -----------------------------------------------------------------------
# Logs y trazabilidad
# -----------------------------------------------------------------------
AGENT_LOGS_DIR=logs

# -----------------------------------------------------------------------
# LangSmith (opcional, solo trazas/observabilidad -- no afecta la ejecución)
# -----------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=...
